# Host runner only. Enter the paths of the active deployment.
WMS_REPO_DIR=/opt/musonoi-wms
WMS_COMPOSE_PROJECT=musonoi-production
WMS_COMPOSE_FILE=/opt/musonoi-wms/deploy/compose.production.yaml
WMS_COMPOSE_ENV_FILE=/etc/musonoi/production.paths
# One absolute override path per line, in the existing Compose order.
# WMS_COMPOSE_OVERRIDES_FILE=/etc/musonoi/nightly-compose-overrides.list
# WMS_BACKUP_HOST_DIR=/var/lib/musonoi/nightly
# WMS_BACKUP_SECRET_DIR=/etc/musonoi/nightly-backup
# WMS_BACKUP_JOB_ENV_FILE=/etc/musonoi/nightly-backup.env
# WMS_PG_CLIENT_MAJOR=17
# WMS_REPORT_SECRET_DIR=/etc/musonoi/report-mail
# WMS_REPORT_JOB_ENV_FILE=/etc/musonoi/report-job.env
# WMS_REPORT_STATE_DIR=/var/lib/musonoi/report-mail
